#!/usr/bin/env python3
"""List local VCF credentials and optional SDDC API credentials; export one CSV."""
import argparse
import csv
import json
import os
import re
import socket
import ssl
import sys
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, build_opener, HTTPSHandler, HTTPRedirectHandler

KEYS = ('VCF_SDDC_HOST', 'VCF_SDDC_USER', 'VCF_SDDC_PASSWORD',
        'VCF_SDDC_API_KEY', 'VCF_SDDC_TOKEN', 'VCF_SDDC_CA_FILE', 'VCF_SDDC_VERIFY_SSL')


def safe(value):
    return ''.join(c if c.isprintable() else repr(c)[1:-1] for c in str(value))


def env_values(path):
    values = {}
    for number, raw in enumerate(path.read_text(encoding='utf-8-sig').splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('export '):
            line = line[7:].lstrip()
        key, separator, value = line.partition('=')
        key, value = key.strip(), value.strip()
        if not separator or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key):
            raise ValueError(f'{path.name}: invalid KEY=VALUE syntax on line {number}')
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key in KEYS:
            values[key] = value
    return values


def discover_env():
    selected = []
    for path in sorted(Path.cwd().iterdir()):
        if not path.is_file() or not (path.name == '.env' or path.name.startswith('.env.')
                                     or path.name.startswith('.vcf-sddc')
                                     or path.suffix.lower() == '.env'):
            continue
        text = path.read_text(encoding='utf-8-sig')
        if re.search(r'^\s*(?:export\s+)?VCF_SDDC_(?:HOST|USER|PASSWORD|API_KEY|TOKEN)\s*=',
                     text, re.MULTILINE):
            selected.append(path)
    return selected


def json_rows(path):
    data = json.loads(path.read_text(encoding='utf-8-sig'))
    if not isinstance(data, dict) or not isinstance(data.get('components'), list):
        raise ValueError(f'{path.name}: expected a components array')
    rows = []
    for component in data['components']:
        if not isinstance(component, dict) or not isinstance(component.get('credentials', []), list):
            raise ValueError(f'{path.name}: invalid component or credentials array')
        for cred in component.get('credentials', []):
            if not isinstance(cred, dict):
                raise ValueError(f'{path.name}: invalid credential object')
            rows.append((component.get('FQDN', ''), cred.get('user', ''),
                         cred.get('password', ''), component.get('componentName', 'Other')))
    return rows


def discover_json():
    paths = []
    for path in sorted(Path.cwd().iterdir()):
        if path.is_file() and path.suffix.lower() == '.json':
            with path.open(encoding='utf-8-sig') as source:
                prefix = source.read(4096)
            if re.match(r'^\s*\{\s*"components"\s*:\s*\[', prefix):
                paths.append(path)
    return paths


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def api_rows(config, insecure, ca_file=None):
    host = config.get('VCF_SDDC_HOST', '').strip()
    parsed = urlsplit(host if '://' in host else 'https://' + host)
    if (parsed.scheme != 'https' or not parsed.hostname or parsed.username or parsed.password
            or parsed.path not in ('', '/') or parsed.query or parsed.fragment):
        raise ValueError('VCF_SDDC_HOST must be a hostname/IP, optionally with HTTPS and a port')
    base = 'https://' + parsed.netloc
    verify = config.get('VCF_SDDC_VERIFY_SSL', 'true').lower()
    if verify not in ('true', 'false'):
        raise ValueError('VCF_SDDC_VERIFY_SSL must be true or false')
    insecure = insecure or verify == 'false'
    ca_file = ca_file or config.get('VCF_SDDC_CA_FILE')
    context = ssl._create_unverified_context() if insecure else ssl.create_default_context(
        cafile=str(Path(ca_file).expanduser()) if ca_file else None)
    opener = build_opener(HTTPSHandler(context=context), NoRedirect())

    def request(endpoint, token=None, body=None):
        headers = {'Accept': 'application/json', 'Content-Type': 'application/json'}
        if token:
            headers['Authorization'] = 'Bearer ' + token
        req = Request(base + endpoint, headers=headers,
                      data=json.dumps(body).encode() if body is not None else None)
        try:
            with opener.open(req, timeout=60) as response:
                data = json.load(response)
        except HTTPError as error:
            # Do not print server response bodies: they may contain credentials.
            hint = {401: 'authentication rejected; check the SDDC Manager account/password or token',
                    403: 'access denied; check SDDC Manager permissions',
                    400: 'request rejected; check the configured authentication settings'}.get(error.code, 'API request failed')
            raise ValueError(f'{parsed.netloc}: {endpoint.split("?")[0]} HTTP {error.code}: {hint}') from error
        except (URLError, TimeoutError, OSError) as error:
            reason = error.reason if isinstance(error, URLError) else error
            if isinstance(reason, ssl.SSLCertVerificationError):
                detail = ('TLS certificate verification failed: ' + safe(reason.verify_message)
                          + '. Use --ca-file with the issuing CA, or --insecure to test without verification')
            elif isinstance(reason, ssl.SSLError):
                detail = 'TLS handshake failed: ' + safe(str(reason))
            elif isinstance(reason, socket.gaierror):
                detail = 'DNS lookup failed; verify the manager hostname'
            elif isinstance(reason, ConnectionRefusedError):
                detail = 'HTTPS connection refused; check the API listener and port'
            elif isinstance(reason, (TimeoutError, socket.timeout)):
                detail = 'HTTPS connection timed out; check routing, firewall, and API availability'
            else:
                detail = 'HTTPS connection failed: ' + safe(str(reason))
            raise ValueError(f'{parsed.netloc}: {detail}') from error
        if not isinstance(data, dict):
            raise ValueError(f'{parsed.netloc}: API response must be a JSON object')
        return data

    token = config.get('VCF_SDDC_TOKEN')
    if not token:
        user = config.get('VCF_SDDC_USER')
        secret = config.get('VCF_SDDC_API_KEY') or config.get('VCF_SDDC_PASSWORD')
        if not user or not secret:
            raise ValueError(f'{parsed.netloc}: set VCF_SDDC_USER and password/API key, or VCF_SDDC_TOKEN')
        payload = {'username': user,
                   'apiKey' if config.get('VCF_SDDC_API_KEY') else 'password': secret}
        token = request('/v1/tokens', body=payload).get('accessToken')
        if not isinstance(token, str) or not token:
            raise ValueError(f'{parsed.netloc}: no accessToken returned')
    data = request('/v1/credentials?pageNumber=0&pageSize=0', token=token)
    elements = data.get('elements')
    if not isinstance(elements, list):
        raise ValueError(f'{parsed.netloc}: API response has no elements array')
    rows = []
    for cred in elements:
        if not isinstance(cred, dict) or not isinstance(cred.get('resource', {}), dict):
            raise ValueError(f'{parsed.netloc}: invalid API credential record')
        resource = cred.get('resource', {})
        rows.append((resource.get('resourceName', ''), cred.get('username', ''),
                     cred.get('password', ''), resource.get('resourceType', 'Other')))
    return rows


def display(rows):
    print(f'Passwords found: {len(rows)}\n')
    if not rows:
        return
    clean = [tuple(safe(row[i]) for i in (0, 1, 2, 4)) for row in rows]
    widths = [max(len(title), *(len(row[i]) for row in clean))
              for i, title in enumerate(('FQDN', 'Username', 'Password', 'Source'))]
    for row in [('FQDN', 'Username', 'Password', 'Source'), tuple('-' * w for w in widths)] + clean:
        print('  '.join(v.ljust(w) for v, w in zip(row, widths)).rstrip())


def component_folder(value):
    names = {
        'ESXI': 'Hosts',
        'NSXT_MANAGER': 'NSX Manager',
        'EXISTING NSX MANAGER': 'NSX Manager',
        'NSXT_EDGE': 'NSX Edge',
        'NSX_ALB': 'NSX Advanced Load Balancer',
        'VCENTER': 'vCenter',
        'EXISTING VCENTER': 'vCenter',
        'PSC': 'vCenter',
        'SDDC_MANAGER': 'SDDC Manager',
        'BACKUP': 'SDDC Manager',
        'VCF_OPERATIONS': 'VCF Operations',
        'VCF_AUTOMATION': 'VCF Automation',
        'VCF_SERVICES_RUNTIME': 'VCF Management Services',
        'VSP': 'VCF Management Services',
    }
    value = value.strip() or 'Other'
    return names.get(value.upper(), value)


def folder(row):
    host, _, _, component = row[:4]
    domain = host.split('.', 1)[1] if '.' in host else 'VCF'
    return '\\'.join(re.sub(r'[\\/\x00-\x1f]', '_', value)
                     for value in ('vcf-password-tool', domain, component_folder(component)))


def export_csv(path, rows):
    # Create one new file, without overwriting an earlier plaintext export.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8', newline='') as handle:
            writer = csv.writer(handle, quoting=csv.QUOTE_ALL, lineterminator='\n')
            for row in rows:
                host, user, password, _ = row[:4]
                writer.writerow((host, folder(row), f'{host} ({user})', user, password, 'SSH2'))
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('list', 'export'))
    parser.add_argument('files', nargs='*', metavar='JSON', help='Explicit JSON files; default: discover in current directory')
    parser.add_argument('--env-file', action='append', metavar='FILE', help='Explicit API environment file; default: discover .vcf-sddc* and .env files in the current directory')
    parser.add_argument('--sddc', help='Override the SDDC Manager hostname')
    parser.add_argument('--insecure', action='store_true', help='Skip HTTPS certificate verification for API queries')
    parser.add_argument('--ca-file', metavar='PEM', help='Trust this CA certificate bundle for API HTTPS')
    parser.add_argument('--output', default='vcf-securecrt-import.csv', metavar='CSV', help='Export CSV path (default: current directory)')
    if len(sys.argv) == 1:
        parser.print_help()
        return 0
    args = parser.parse_args()
    if args.command == 'list' and args.output != 'vcf-securecrt-import.csv':
        parser.error('--output is only used with export')
    errors, gathered = [], []
    loaded_json, api_success = 0, 0

    def collect(label, operation, source=None):
        try:
            gathered.extend((tuple(row) + (source or Path(label).name,), label) for row in operation())
            return True
        except (OSError, UnicodeError, ValueError) as error:
            errors.append(f'{safe(label)}: {safe(error)}')
            return False

    try:
        json_paths = [Path(f).expanduser() for f in args.files] if args.files else discover_json()
        env_paths = [Path(f).expanduser() for f in args.env_file] if args.env_file else discover_env()
    except (OSError, UnicodeError) as error:
        print('ERROR: file discovery failed: ' + safe(error), file=sys.stderr)
        return 1
    if args.sddc and len(env_paths) > 1:
        parser.error('--sddc requires at most one selected environment file; use --env-file to select it')
    for path in json_paths:
        loaded_json += collect(str(path), lambda p=path: json_rows(p))
    manager_hosts = sorted({row[0].strip().rstrip('.').lower() for row, _ in gathered
                            if isinstance(row[0], str) and row[0].strip()
                            and row[3] == 'SDDC Manager'})
    base = {key: os.environ[key] for key in KEYS if key in os.environ}
    configs = []
    for path in env_paths:
        try:
            values = env_values(path)
            if not values:
                raise ValueError('no VCF_SDDC settings found')
            configs.append((str(path), dict(base, **values)))
        except (OSError, UnicodeError, ValueError) as error:
            errors.append(f'{safe(path)}: {safe(error)}')
    if not env_paths and (base or args.sddc):
        configs.append(('environment', base))
    for label, config in configs:
        if args.sddc:
            config['VCF_SDDC_HOST'] = args.sddc
        if not config.get('VCF_SDDC_HOST'):
            if len(manager_hosts) == 1:
                config['VCF_SDDC_HOST'] = manager_hosts[0]
            else:
                errors.append(f'{safe(label)}: set VCF_SDDC_HOST or pass --sddc; no unique manager found in JSON')
                continue
        if args.insecure or config.get('VCF_SDDC_VERIFY_SSL', '').lower() == 'false':
            print(f'WARNING: TLS verification disabled for {safe(config["VCF_SDDC_HOST"])}', file=sys.stderr)
        api_success += collect(f'API {config["VCF_SDDC_HOST"]} (settings: {label})',
                               lambda c=config: api_rows(c, args.insecure, args.ca_file), source='sddcm_api')

    dedupe = {}
    for row, label in gathered:
        if any(not isinstance(value, str) for value in row):
            errors.append(f'{safe(label)}: credential fields must be strings')
            continue
        host, user, password, component, source = row
        host, user = host.strip().rstrip('.').lower(), user.strip()
        if not host or not user or not password:
            continue
        if any(c in host or c in user for c in ('\n', '\r', '\x00')):
            errors.append(f'{safe(label)}: invalid host or username')
            continue
        key = host, user  # Usernames remain case-sensitive.
        previous = dedupe.get(key)
        if previous and previous[2] != password:
            print(f'WARNING: conflicting password for {safe(host)} / {safe(user)}; using {safe(label)}', file=sys.stderr)
        dedupe[key] = (host, user, password, component, source)
    rows = sorted(dedupe.values(), key=lambda r: (r[0], r[1]))
    print(f'Sources: JSON {loaded_json}/{len(json_paths)} files loaded; API {api_success}/{len(configs)} managers loaded')
    if errors:
        print('Status: PARTIAL — source errors occurred; the table contains only successfully loaded credentials.')
    print()
    display(rows)
    for error in errors:
        print('ERROR: ' + error, file=sys.stderr)
    if errors:
        if args.command == 'export':
            print('\nNo CSV created because one or more sources failed.', file=sys.stderr)
        return 1
    if not rows:
        print('No password-bearing credentials found; no CSV created.')
        return 0
    if args.command == 'export':
        path = Path(args.output).expanduser()
        try:
            export_csv(path, rows)
        except FileExistsError:
            print(f'ERROR: {safe(path)} already exists; choose another --output path.', file=sys.stderr)
            return 1
        except OSError as error:
            print('ERROR: could not create CSV: ' + safe(error), file=sys.stderr)
            return 1
        print(f'\nSecureCRT CSV: {safe(path.resolve())} ({len(rows)} sessions)')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
